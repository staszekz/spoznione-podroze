{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spoznione-podroze",
	"compatibility_date": "2026-10-26",
	// Static Astro build served as Workers static assets — no adapter, no Worker script.
	"assets": {
		"directory": "./dist",
		// Serve dist/404.html with a 404 status for unknown paths.
		"not_found_handling": "404-page"
	},
	// Required by `wrangler preview`, which Workers Builds runs for PR branches.
	// Empty: previews inherit assets and compatibility settings from the top level.
	"previews": {}
}
