---
import { Font } from "astro:assets";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_TITLE } from "@/consts";
import { type Lang, ui } from "@/i18n/ui";
import "@/styles/global.css";

interface Props {
	lang: Lang;
	title?: string;
	description: string;
	/** URL of this page in the other language, for the PL|EN switcher. */
	altHref?: string;
	/** Absolute URL of the share image (og:image), e.g. the post cover. */
	image?: string;
	/** Set on posts: switches og:type to "article" and adds its dates. */
	article?: { publishedAt: string | null; modifiedAt: string | null };
	/** Structured data (schema.org) rendered as JSON-LD. */
	jsonLd?: Record<string, unknown>;
	noindex?: boolean;
}

const {
	lang,
	title,
	description,
	altHref,
	image,
	article,
	jsonLd,
	noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;

// Production redirects "/path" to "/path/" (307), so every URL we advertise
// to crawlers ends with a slash — otherwise canonical points at a redirect.
const absolute = (path: string) =>
	new URL(path.endsWith("/") ? path : `${path}/`, Astro.site).href;
const canonical = absolute(Astro.url.pathname);
const otherLang: Lang = lang === "pl" ? "en" : "pl";
const altUrl = altHref ? absolute(altHref) : undefined;
const ogLocale = { pl: "pl_PL", en: "en_US" } as const;
const rssHref = lang === "pl" ? "/rss.xml" : "/en/rss.xml";
// JSON.stringify leaves "</script>" intact; escaping "<" keeps CMS text from
// closing the tag early.
const jsonLdHtml = jsonLd
	? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
	: undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{pageTitle}</title>
		<meta name="description" content={description}>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<link rel="sitemap" href="/sitemap-index.xml">
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={rssHref}
		>
		{noindex ? (
			<meta name="robots" content="noindex">
		) : (
			<link rel="canonical" href={canonical}>
		)}
		{!noindex && altUrl && (
			<>
				<link rel="alternate" hreflang={lang} href={canonical}>
				<link rel="alternate" hreflang={otherLang} href={altUrl}>
				<link
					rel="alternate"
					hreflang="x-default"
					href={lang === "pl" ? canonical : altUrl}
				>
			</>
		)}
		<meta property="og:site_name" content={SITE_TITLE}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description}>
		<meta property="og:url" content={canonical}>
		<meta property="og:locale" content={ogLocale[lang]}>
		{altUrl && (
			<meta property="og:locale:alternate" content={ogLocale[otherLang]}>
		)}
		<meta property="og:type" content={article ? "article" : "website"}>
		{article?.publishedAt && (
			<meta property="article:published_time" content={article.publishedAt}>
		)}
		{article?.modifiedAt && (
			<meta property="article:modified_time" content={article.modifiedAt}>
		)}
		{image && <meta property="og:image" content={image}>}
		<meta
			name="twitter:card"
			content={image ? "summary_large_image" : "summary"}
		>
		{jsonLdHtml && (
			<script is:inline type="application/ld+json" set:html={jsonLdHtml} />
		)}
		<Font cssVariable="--font-bricolage" preload />
		<Font cssVariable="--font-hanken" preload />
		<Font cssVariable="--font-dm-mono" />
		<script is:inline>
		(() => {
			const stored = localStorage.getItem("theme");
			const dark = stored
				? stored === "dark"
				: window.matchMedia("(prefers-color-scheme: dark)").matches;
			document.documentElement.classList.toggle("dark", dark);
		})();
		</script>
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-foreground focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-background"
		>
			{ui[lang]["a11y.skipToContent"]}
		</a>
		<div
			class="mx-auto flex min-h-screen w-full max-w-[1200px] flex-col px-5 md:px-7"
		>
			<Header lang={lang} altHref={altHref} />
			<main id="main" tabindex="-1" class="flex-1 focus:outline-none">
				<slot />
			</main>
			<Footer lang={lang} />
		</div>
	</body>
</html>
