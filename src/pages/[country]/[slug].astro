---
import PostPage from "@/components/post/PostPage.astro";
import { getPost } from "@/sanity/lib/queries";

export async function getStaticPaths() {
	const { getPostSlugs } = await import("@/sanity/lib/queries");
	const slugs = await getPostSlugs("pl");
	return slugs.map(({ slug, country }) => ({ params: { country, slug } }));
}

const lang = "pl" as const;
const slug = Astro.params.slug ?? "";
const country = Astro.params.country ?? "";
const post = await getPost(lang, country, slug);
if (!post) return Astro.redirect("/404");
---

<PostPage lang={lang} post={post} />
