---
import CollabBand from "@/components/CollabBand.astro";
import ContinentPills from "@/components/ContinentPills.tsx";
import FeaturedStories from "@/components/FeaturedStories.tsx";
import Hero from "@/components/Hero.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ogImageUrl } from "@/sanity/lib/image";
import { getHomepageData } from "@/sanity/lib/queries";

const lang = "en" as const;
const data = await getHomepageData(lang);
// getHomepageData sorts continents by postCount desc, so [0] is the default.
const defaultId = data.continents[0]?._id;
if (!defaultId) return Astro.redirect("/en/continents");
// Share image: the cover of the first (featured or newest) story.
const cover = data.stories[0]?.coverImage;
const shareImage = cover?.asset ? ogImageUrl(cover) : undefined;
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_TITLE,
	description: SITE_DESCRIPTION.en,
	url: new URL("/en/", Astro.site).href,
	inLanguage: lang,
};
---

<BaseLayout
	lang={lang}
	description={SITE_DESCRIPTION.en}
	altHref="/"
	image={shareImage}
	jsonLd={jsonLd}
>
	<Hero
		lang={lang}
		continents={data.continents}
		countries={data.countries}
		defaultId={defaultId}
	/>
	<ContinentPills
		client:idle
		continents={data.continents}
		defaultId={defaultId}
	/>
	<FeaturedStories
		client:idle
		continents={data.continents}
		stories={data.stories}
		defaultId={defaultId}
		lang={lang}
	/>
	<CollabBand lang={lang} />
</BaseLayout>
