---
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import MobileMenu from "@/components/MobileMenu.tsx";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { COLLAB_PAGE_LIVE, SITE_TITLE } from "@/consts";
import type { Lang } from "@/i18n/ui";
import { getTranslations, localizePath, routes } from "@/i18n/ui";

interface Props {
	lang: Lang;
	altHref?: string;
}

const { lang, altHref } = Astro.props;
const t = getTranslations(lang);
const r = routes[lang];

const navItems = [
	{ href: r.continents, label: t("nav.continents") },
	{ href: r.latest, label: t("nav.latest") },
	{ href: r.about, label: t("nav.about") },
	...(COLLAB_PAGE_LIVE ? [{ href: r.collab, label: t("nav.collab") }] : []),
];
---

<header class="flex items-center justify-between gap-3 py-4 md:py-[26px]">
	<a
		href={localizePath(lang, "/")}
		class="-my-2 py-2 font-display text-base leading-[1.15] font-extrabold tracking-[-0.02em] text-foreground sm:text-lg md:text-[22px]"
	>
		{SITE_TITLE}
	</a>

	<nav class="hidden items-center gap-8 md:flex">
		{navItems.map((item) => (
			<a
				href={item.href}
				class="text-[15px] font-medium text-nav-foreground hover:text-foreground"
			>
				{item.label}
			</a>
		))}
	</nav>

	<div class="flex flex-none items-center gap-2 sm:gap-2.5">
		<LanguageSwitch lang={lang} altHref={altHref} />
		<ThemeToggle lang={lang} />
		<div class="md:hidden">
			<MobileMenu
				client:media="(width < 48rem)"
				items={navItems}
				openLabel={t("menu.open")}
				closeLabel={t("menu.close")}
			/>
		</div>
	</div>
</header>
