---
import SanityImage from "@/components/SanityImage.tsx";
import { croppedHeight } from "@/lib/crop";
import type { CaptionedImage } from "@/sanity/lib/queries";

interface Props {
	node: CaptionedImage;
}

const { node } = Astro.props;
const WIDTH = 1440;
const height = croppedHeight(
	WIDTH,
	node.asset?.metadata?.dimensions,
	node.crop,
	960,
);
---

{node.asset && (
	<figure class="my-2 flex flex-col gap-2">
		<SanityImage
			image={node}
			width={WIDTH}
			height={height}
			sizes="(min-width: 760px) 720px, calc(100vw - 40px)"
			className="h-auto rounded-[14px]"
		/>
		{node.caption && (
			<figcaption class="text-sm text-muted-foreground">
				{node.caption}
			</figcaption>
		)}
	</figure>
)}
