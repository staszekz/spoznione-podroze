---
import SanityImage from "@/components/SanityImage.tsx";
import type { CaptionedImage } from "@/sanity/lib/queries";

interface Props {
	node: CaptionedImage;
}

const { node } = Astro.props;
const WIDTH = 1440;
// Keep the aspect ratio of what the author picked: the original minus the
// Studio crop. Using the uncropped ratio made the builder crop a second time.
const dims = node.asset?.metadata?.dimensions;
const crop = node.crop;
const height = dims
	? Math.round(
			(WIDTH * dims.height * (1 - (crop?.top ?? 0) - (crop?.bottom ?? 0))) /
				(dims.width * (1 - (crop?.left ?? 0) - (crop?.right ?? 0))),
		)
	: 960;
---

{node.asset && (
	<figure class="my-2 flex flex-col gap-2">
		<SanityImage
			image={node}
			width={WIDTH}
			height={height}
			sizes="(min-width: 760px) 720px, calc(100vw - 40px)"
			className="h-auto rounded-[14px]"
		/>
		{node.caption && (
			<figcaption class="text-sm text-muted-foreground">
				{node.caption}
			</figcaption>
		)}
	</figure>
)}
